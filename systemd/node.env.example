# openfiat-node configuration.
#
# Read by systemd as an EnvironmentFile, so values are bare (no `export`,
# no quotes unless the quotes are part of the value).

# Where RocksDB and the node's identity live. The wallet at
# $CLI_DATA_DIR/wallet.json IS the node's protocol identity and the owner of
# its stake — back it up outside this machine, because losing it strands the
# staked OPEN with no way to unbond.
CLI_DATA_DIR=/var/lib/openfiat
CLI_WALLET_PATH=/var/lib/openfiat/wallet.json

# JSON-RPC / HTTP surface (OFS-8200). 7080 rather than 8080: that port is
# crowded on a typical server and a node silently losing the bind race is a
# bad first five minutes.
CLI_HTTP_ADDR=0.0.0.0:7080

# libp2p transport. 0.0.0.0 binds every interface; it is a bind wildcard and
# not something a peer can dial, which is why the announced address is a
# separate concern (see the note on external addresses below).
CLI_LISTEN_ADDR=/ip4/0.0.0.0/udp/4001/quic-v1

# A full, RPC-connected node: it reads Solana directly rather than learning
# on-chain facts second-hand over gossip, and it is what relays other peers'
# transactions. This is the mode that makes it a *full* node.
CLI_CHAIN_MODE=rpc
CLI_SOLANA_RPC_URLS=https://api.devnet.solana.com

# Peers to dial on startup. Empty: this is currently the only node on this
# machine and peer discovery does not yet run (see task #146), so a node has
# no way to find peers it was not explicitly given.
CLI_BOOTSTRAP_PEERS=

# NOTE: there is deliberately no external/announce address setting here yet.
# `openfiat-discovery` gained `add_external_address`, but the discovery
# service is not wired into the node, so nothing would read such a value.
# A setting that looks like configuration and is silently ignored is worse
# than its absence.
LOG_LEVEL=info
