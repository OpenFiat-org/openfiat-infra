[Unit]
Description=Publish devnet FX rates hourly
Documentation=https://github.com/OpenFiat-org/openfiat-core/blob/main/crates/cli/examples/devnet_oracle.rs

[Timer]
# Hourly, against a three-hour record TTL. Two runs may fail before the
# feed goes stale, which is the margin that keeps a transient rate-limit
# or a brief network fault from taking devnet's pricing down.
#
# Not more often: the fiat leg updates daily, and hammering someone's
# free tier for a number that has not moved is rude and gets the caller
# blocked.
OnCalendar=hourly
# Spread across the hour so every deployment of this timer does not hit
# the rate sources on the same second.
RandomizedDelaySec=300
# Publish once shortly after boot rather than waiting for the next hour,
# so a rebooted host is not unpriceable for up to an hour.
OnBootSec=2min
Persistent=true

[Install]
WantedBy=timers.target
